Algoritmo ejercicio_2_numeros
	definir numeroA, numeroB como real
	escribir " escribe el numero A"
	leer numeroA
	
	escribir " escribe numero B"
	leer numeroB
	
	si numeroA = numeroB entonces 
		escribir "son iguales"
		
	sino
		si numeroA > numeroB entonces 
			
			escribir " A es mayor que B"
		sino 
			escribir " B es mayor que A"
		finsi
	FinSi
	
	
FinAlgoritmo
