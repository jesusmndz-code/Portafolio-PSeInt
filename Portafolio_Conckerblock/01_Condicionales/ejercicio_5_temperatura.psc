Algoritmo ejercicio_5_temperatura
	definir temperatura como real
	escribir " indica la teperatura"
	leer temperatura
	si temperatura < 10 Entonces
		escribir " hace frio"
	sino 
		si temperatura >= 10 y temperatura <= 24 Entonces
			escribir " temperatura agradable"
	
			sino 
				escribir " hace calor"
			FinSi
		FinSi

		
	FinAlgoritmo
