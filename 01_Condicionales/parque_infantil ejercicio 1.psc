Algoritmo parque_infantil
	definir nombre Como Caracter
	Escribir "como te llamas?"
	Leer nombre
	Escribir "hola" nombre ", encantado de saludarte"
	definir  edad Como Entero
	escribir "introduce tu edad"
	Leer edad
	si edad <= 12 entonces 
		Escribir "puedes entrar al parque"
	sino 
	escribir "no puedes entrar al parque"
	FinSi 	
FinAlgoritmo
