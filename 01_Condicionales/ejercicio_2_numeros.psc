Algoritmo ejercicio_2_numeros
	definir numero como real
	escribir " indica un numero para comprobar si es positivo o negativo"
	leer numero
	
	si numero = 0 entonces 
		escribir " es 0, no es positivo ni negativo"
		
	sino
		si numero < 0 entonces 
			
			escribir " es un numero negativo"
		sino 
			escribir " es un numero positivo"
			finsi
	FinSi
	
	
FinAlgoritmo
