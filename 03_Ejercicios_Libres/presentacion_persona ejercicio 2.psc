Algoritmo presentacion_persona
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir cuidad_de_nacimiento Como Cadena
	Escribir "como te llamas?"
	Leer nombre
	Escribir "hola" nombre ", encantado de saludarte"
	Escribir "introduce tu edad"
	Leer edad
	Escribir "dime tu cuidad de nacimiento"
	Leer cuidad_de_nacimiento
	borrar pantalla
	Escribir "========================================="
	Escribir "          PRESENTACIÓN PERSONAL          "
	Escribir "========================================="
	Escribir "Hola a todos. Les presento a ", nombre, "."
	Escribir "Tiene ", edad, " años de edad."
	Escribir "Nació en el hermoso lugar de: ", cuidad_de_nacimiento, "."
	Escribir "========================================="
FinAlgoritmo
